# Shared secrets (copy this file to .env at the project root; docker-compose reads it)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password

RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_dev_password
RABBITMQ_URL=amqp://erp:erp_dev_password@rabbitmq:5672

# JWT secrets - MUST be replaced with long random strings in any real deployment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Service URLs used by the API Gateway
ACADEMIC_SERVICE_URL=http://academic-service:4001
FINANCE_SERVICE_URL=http://finance-service:4002
HR_SERVICE_URL=http://hr-service:4003

GATEWAY_PORT=4000
ACADEMIC_PORT=4001
FINANCE_PORT=4002
HR_PORT=4003

FRONTEND_ORIGIN=http://localhost:5173
